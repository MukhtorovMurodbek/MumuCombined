# Settings for running every bot in one process. Copy to .env for a local
# run, or enter the same names as variables on the host.
#
# A bot with no token is simply not started, so any subset works: fill in
# two tokens and two bots run.

# --- the shared family database -------------------------------------------
# One Postgres for every bot, one schema per bot. Each bot's schema is its
# folder name (sticker_bot, convert_bot, ...) and is set automatically --
# DB_SCHEMA is not read here. <PREFIX>_DB_SCHEMA overrides it for one bot.
#
# Supabase: the SESSION pooler string (port 5432), not the transaction pooler
# on 6543 -- that one drops the per-connection schema setting. Percent-encode
# @ : / ? # and spaces in the password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/botfamily

# --- StickerBot -----------------------------------------------------------
SBOT_TOKEN=
SBOT_USERNAME=
# Numeric Telegram user id(s) of the owner, comma-separated. Empty disables
# the owner-only commands.
SBOT_ADMIN_ID=

# --- ConvertBot -----------------------------------------------------------
CBOT_TOKEN=
CBOT_USERNAME=
CBOT_ADMIN_ID=
# Largest upload accepted, in MB. Empty means Telegram's own limit (20 MB,
# or more with a local Bot API server).
CONVERT_MAX_FILE_MB=

# --- DownloaderBot --------------------------------------------------------
DBOT_TOKEN=
DBOT_USERNAME=
DBOT_ADMIN_ID=

# --- AnonBot --------------------------------------------------------------
ABOT_TOKEN=
ABOT_USERNAME=
ABOT_ADMIN_ID=

# --- ManagerBot -----------------------------------------------------------
# Refuses to start without MBOT_ADMIN_ID: it answers the owner only.
MBOT_TOKEN=
MBOT_USERNAME=
MBOT_ADMIN_ID=
# How long without a heartbeat before a bot is reported down, how long a
# remote command may take, and the roll-call at startup.
MBOT_DOWN_AFTER_SECONDS=120
MBOT_COMMAND_TIMEOUT_SECONDS=90
MBOT_ROLLCALL_SECONDS=5
MBOT_ROLLCALL_FRESH_SECONDS=120
# A daily summary at this UTC time (HH:MM). Empty: none.
MBOT_DIGEST_UTC=

# --- what every public bot shows ------------------------------------------
# How the bots point at each other: id:Name:username, comma-separated.
SIBLING_BOTS=stickerbot:StickerBot:YourStickerBotUsername,convertbot:ConvertBot:YourConvertBotUsername,downloaderbot:DownloaderBot:YourDownloaderBotUsername,anonbot:AnonBot:YourAnonBotUsername
# Named in /privacy and /terms as the person to contact. Empty: omitted.
OPERATOR_CONTACT=
# Links to the long forms of /privacy and /terms -- one pair per bot, so each
# takes its prefix. Empty: the in-bot text stands alone.
SBOT_PRIVACY_URL=
SBOT_TERMS_URL=
CBOT_PRIVACY_URL=
CBOT_TERMS_URL=
DBOT_PRIVACY_URL=
DBOT_TERMS_URL=
ABOT_PRIVACY_URL=
ABOT_TERMS_URL=

# --- optional -------------------------------------------------------------
# A self-hosted Bot API server (github.com/tdlib/telegram-bot-api) lifts the
# 20 MB download / 50 MB upload limits. StickerBot and ConvertBot use it.
LOCAL_BOT_API_URL=
LOCAL_BOT_API_MODE=true
# Card payments for /donate, per bot: a provider token from @BotFather is
# issued for one bot, so it is SBOT_PAYMENT_PROVIDER_TOKEN_USD and so on.
# Empty (the normal state): Telegram Stars only.
SBOT_PAYMENT_PROVIDER_TOKEN_USD=
CBOT_PAYMENT_PROVIDER_TOKEN_USD=
DBOT_PAYMENT_PROVIDER_TOKEN_USD=
ABOT_PAYMENT_PROVIDER_TOKEN_USD=

# --- the one-process runner -----------------------------------------------
# Which bots to run: any of sticker, convert, downloader, anon, manager.
# Empty: every bot that has a token.
BOTS=
# Threads shared by all the bots for blocking work (database calls, image
# encoding, downloads). Started only when needed.
WORKER_THREADS=8
# Minutes between the one-line status report in the log. 0 turns it off.
UNIFIED_STATUS_MINUTES=30
# Seconds a shutdown waits for the bots to tell interrupted users what
# happened.
UNIFIED_DRAIN_SECONDS=30

# Every other setting a bot understands has a working default. Any of them
# can be set for the whole process under its own name, or for one bot by
# adding that bot's prefix (SBOT_, CBOT_, DBOT_, ABOT_, MBOT_):
#   POLL_TIMEOUT=30          every bot
#   DBOT_POLL_TIMEOUT=50     DownloaderBot only
